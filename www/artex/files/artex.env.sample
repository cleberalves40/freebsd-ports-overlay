# Variaveis extras do ARTEX (KEY=valor, uma por linha), lidas a cada inicio
# do servico. Sobrepoem as do rc.conf / lancador. Referencia:
# https://github.com/BaaRai/ARTEX
#
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# ARTEX_LLM_PROVIDER=
# ARTEX_LLM_MODEL=
# ARTEX_LLM_BASE_URL=
# ARTEX_LLM_PROXY=
# ARTEX_NOISE_PROFILE=balanced
# ARTEX_SECRET_KEY=
# ARTEX_UNTRUSTED_BOUNDARY=
