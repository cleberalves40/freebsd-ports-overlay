# Variaveis extras do Thinker (KEY=valor, uma por linha), lidas a cada inicio
# do servico. Sobrepoem as do rc.conf. Referencia:
# https://github.com/patrickbrandao/thinker/blob/main/docs/usuario/configuracao.md
#
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=...
# OLLAMA_HOST=http://127.0.0.1:11434
# PROVIDER_TIMEOUT_MS=180000
# THINKER_RECORDING_RETENTION_DAYS=30
